# -----------------------------------------------------------------------------
# ROOT .ENV
# -----------------------------------------------------------------------------
# This file is a single consolidated template for the repository's runtime and
# deployment configuration. It is intended as a convenience reference for:
#
# - local environment setup
# - GitHub Actions secret sync
# - generating service-specific env files under `infra/envs/`
#
# Do not commit a populated `.env`.
#
# Preferred pattern: keep the real values in `infra/envs/` and let the root
# `.env` import them. Repo scripts set `QUANT_AGENTIC_RAG_ROOT` automatically.
# When sourcing manually in a shell, export it first:
#
#   export QUANT_AGENTIC_RAG_ROOT=/absolute/path/to/quant-agentic-rag
#   set -a; . ./.env; set +a

: "${QUANT_AGENTIC_RAG_ROOT:?Set QUANT_AGENTIC_RAG_ROOT before sourcing .env}"

. "${QUANT_AGENTIC_RAG_ROOT}/infra/envs/research.env"
. "${QUANT_AGENTIC_RAG_ROOT}/infra/configs/research.env"

# Optional local-only secrets for GitHub or infra sync workflows.
if [ -f "${QUANT_AGENTIC_RAG_ROOT}/infra/envs/github-actions.env" ]; then
  . "${QUANT_AGENTIC_RAG_ROOT}/infra/envs/github-actions.env"
fi
