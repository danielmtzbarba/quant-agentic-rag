# -----------------------------------------------------------------------------
# RESEARCH SERVICE CONFIG (NON-SECRET)
# -----------------------------------------------------------------------------
# Tracked runtime configuration intended for ConfigMap-style materialization.

APP_NAME=research-service
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=logfmt
APP_HOST=0.0.0.0
APP_PORT=8000
API_CORS_ORIGINS=

OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_RERANKER_MODEL=gpt-4o-mini

THESIS_STORAGE_PROVIDER=local
THESIS_ARTIFACT_BUCKET=thesis-artifacts
THESIS_ARTIFACT_LOCAL_MIRROR=false
THESIS_ARTIFACT_BASE_DIR=/app/data/reports

AWS_REGION=
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

DATA_DIR=/app/data
RAG_CORPUS_DIR=/app/data/chunks
DEFAULT_TOP_K=4
DB_ECHO=false
DB_SCHEMA=rag

SEC_COMPANY_NAME=Quant Agentic RAG
SEC_EMAIL_ADDRESS=you@example.com
SEC_METADATA_VERSION=1.0

VANTAGE_BASE_URL=https://www.alphavantage.co/query
TRANSCRIPT_METADATA_VERSION=1.0
NEWS_METADATA_VERSION=1.0
TRANSCRIPT_HTTP_TIMEOUT_S=30
TRANSCRIPT_HTTP_MAX_RETRIES=3
TRANSCRIPT_HTTP_BACKOFF_BASE_S=0.75
TRANSCRIPT_HTTP_BACKOFF_MAX_S=10

RETRIEVAL_CANDIDATE_POOL=48
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_WINDOW=1
RETRIEVAL_NEIGHBOR_LIMIT=2
RETRIEVAL_RERANK_TOP_N=24
RETRIEVAL_EMBEDDING_BATCH_SIZE=32
RETRIEVAL_QUERY_PLAN_LIMIT=4
RETRIEVAL_MAX_PER_DOCUMENT=2
RETRIEVAL_MAX_NEWS_CHUNKS=2
RETRIEVAL_MAX_TRANSCRIPT_CHUNKS=3
RETRIEVAL_MAX_FILING_CHUNKS=3
RETRIEVAL_SENTIMENT_RECENCY_DAYS=45
RETRIEVAL_RISK_RECENCY_DAYS=120

VERIFIER_MAX_UNSUPPORTED_FINDINGS=0
VERIFIER_MAX_PARTIALLY_GROUNDED_FINDINGS=1
